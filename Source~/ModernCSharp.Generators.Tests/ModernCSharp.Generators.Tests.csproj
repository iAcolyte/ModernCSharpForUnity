<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <!-- Same Roslyn as Unity 6000.6. Raise it together with Unity's compiler to see which feature statuses change. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
    <!-- Unity compiles against netstandard2.1. -->
    <PackageReference Include="NETStandard.Library.Ref" Version="2.1.0" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ModernCSharp.Generators/ModernCSharp.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NetStandardReference</_Parameter1>
      <_Parameter2>$(PkgNETStandard_Library_Ref)/ref/netstandard2.1/netstandard.dll</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PackageReadme</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../README.md'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Feature snippets are test data, compiled by the tests themselves. -->
  <ItemGroup>
    <Compile Remove="Features/**" />
    <None Include="Features/**/*.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
